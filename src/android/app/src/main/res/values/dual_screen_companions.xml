    <style name="Widget.Eden.DualScreenBadge" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:background">@drawable/dual_screen_badge_background</item>
        <item name="android:src">@drawable/ic_dual_screen</item>
        <item name="android:tint">?attr/colorOnPrimaryContainer</item>
        <item name="android:visibility">gone</item>
        <item name="android:elevation">2dp</item>
    </style>
    <string name="dual_screen_download_available">%1$s: dual-screen companion available to download</string>
    <string name="dual_screen_update_available">%1$s: dual-screen companion update available</string>
    <style name="Widget.Eden.DualScreenDownload" parent="">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:padding">2dp</item>
        <item name="android:background">@drawable/dual_screen_download_background</item>
        <item name="android:src">@drawable/ic_companion_download</item>
        <item name="android:tint">@android:color/white</item>
        <item name="android:visibility">gone</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:elevation">3dp</item>
    </style>
    <color name="dual_screen_badge_current">#2E7D32</color>
    <color name="dual_screen_badge_available">#1565C0</color>
    <dimen name="dual_screen_fetch_option_spacing">8dp</dimen>

    <!-- The library's "not in your library" section (UnownedCompanionGamesAdapter). -->
    <item name="companion_cover_title" type="id" />
    <item name="companion_unowned_toggle" type="id" />
    <item name="companion_unowned_tile_type" type="id" />
    <color name="companion_unowned_fallback">#28282C</color>
    <color name="companion_unowned_glyph">#96969B</color>
    <color name="companion_unowned_title">#A0A0A0</color>
    <color name="companion_unowned_header">#C8C8C8</color>
    <color name="companion_unowned_credit">#8C8C8C</color>
    <color name="companion_unowned_divider">#33FFFFFF</color>
    <!-- Space under the section header; with the tile card insets about the H2 mockup gap
         (normal gap + 30 px at the Thor 1080p screen). -->
    <dimen name="companion_unowned_header_gap">8dp</dimen>
    <style name="Widget.Eden.UnownedChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/companion_unowned_chip_background</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:text">@string/companion_unowned_chip</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:elevation">2dp</item>
    </style>
</resources>
